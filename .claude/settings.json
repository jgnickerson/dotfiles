{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "claude-fable-5-1[1m]",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.config/iterm2/cc-status ] && ~/.config/iterm2/cc-status || true"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.config/iterm2/cc-status ] && ~/.config/iterm2/cc-status || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.config/iterm2/cc-status ] && ~/.config/iterm2/cc-status || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.config/iterm2/cc-status ] && ~/.config/iterm2/cc-status || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.config/iterm2/cc-status ] && ~/.config/iterm2/cc-status || true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.config/iterm2/cc-status ] && ~/.config/iterm2/cc-status || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.config/iterm2/cc-status ] && ~/.config/iterm2/cc-status || true"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.config/iterm2/cc-status ] && ~/.config/iterm2/cc-status || true"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.config/iterm2/cc-status ] && ~/.config/iterm2/cc-status || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.config/iterm2/cc-status ] && ~/.config/iterm2/cc-status || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "linear@claude-plugins-official": true
  },
  "effortLevel": "high",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    }
  }
}
